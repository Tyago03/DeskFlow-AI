        "options": {"timeout": 120000}
      },
      "id": "deskflow-forward-ticket",
      "name": "Enviar para DeskFlow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [490, 320]
    },
    {
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {}
      },
      "id": "deskflow-response",
      "name": "Responder com ticket",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [750, 320]
    }
  ],
  "connections": {
    "Webhook de entrada": {"main": [[{"node": "Enviar para DeskFlow", "type": "main", "index": 0}]]},
    "Enviar para DeskFlow": {"main": [[{"node": "Responder com ticket", "type": "main", "index": 0}]]}
