# Copie para .env apenas como referência das variáveis. Nunca versionar .env.
DESKFLOW_MODEL=qwen3:4b-instruct
DESKFLOW_OLLAMA_URL=http://127.0.0.1:11434
DESKFLOW_PORT=8000
DESKFLOW_DATA_DIR=data
# Defina DESKFLOW_INGEST_KEY em uma variável de ambiente ou arquivo local NÃO versionado.
# Para conectar n8n via Docker, DESKFLOW_ALLOW_DOCKER=1 inicia o backend em 0.0.0.0.
DESKFLOW_DEMO_MODE=0
